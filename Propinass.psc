Algoritmo Propinass
	Definir Personas Como Entero
	Escribir "¿Cuantos son?"
	Leer Personas
	Definir Cuenta Como Real
	Escribir "¿Cuanto es la Cuenta?"
	Leer Cuenta
	Definir Propina Como Real
	Propina <- Cuenta * 0.10
	Escribir "El valor de la Propina es:$", Propina
	Definir Total Como Real
	Total <- Cuenta + Propina
	Escribir "Total:$" Total
	Definir Unitario Como Real
	Unitario <- Total / Personas
	Escribir "El valor a pagar cada uno es:$", Unitario
FinAlgoritmo
